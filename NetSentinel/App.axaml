<Application xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="NetSentinel.App"
    xmlns:local="using:NetSentinel"
    xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
    RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <shad:ShadTheme />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceInclude x:Key="Dark" Source="avares://NetSentinel/Resources/Dark.axaml" />
                <ResourceInclude x:Key="Light" Source="avares://NetSentinel/Resources/Light.axaml" />
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>