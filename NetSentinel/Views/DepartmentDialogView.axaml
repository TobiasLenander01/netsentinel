<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NetSentinel.ViewModels"
    x:Class="NetSentinel.Views.DepartmentDialogView"
    x:DataType="vm:DepartmentDialogViewModel">

    <Grid>
        <StackPanel Spacing="20" Margin="40" Width="400" HorizontalAlignment="Left">

            <TextBlock Text="{Binding Title}" Classes="h2" />

            <StackPanel Spacing="6">
                <TextBlock Text="Name" />
                <TextBox Text="{Binding Name}" Watermark="Department name" />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="Location" />
                <TextBox Text="{Binding Location}" Watermark="e.g. Building A" />
            </StackPanel>

            <Button Content="Save" Classes="Primary" Command="{Binding SaveDepartmentCommand}" />

        </StackPanel>
    </Grid>
</UserControl>
