<shad:Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NetSentinel.ViewModels"
    xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
    Height="800" Width="1200"
    x:Class="NetSentinel.Views.MainWindow"
    x:DataType="vm:MainWindowViewModel"
    Icon="/Assets/avalonia-logo.ico"
    Title="Net Sentinel">

    <Grid ColumnDefinitions="Auto, *">

        <shad:Sidebar Grid.Column="0"
            Expanded="{Binding #Toggler.IsChecked}"
            MinWidth="70"
            Width="260"
            Background="{DynamicResource CardBackgroundColor}"
            BorderThickness="0,0,1,0"
            Padding="12">

            <StackPanel Spacing="4">

                <TextBlock Text="Platform" Classes="Caption Muted" FontWeight="SemiBold"
                    Margin="12,0,0,8"
                    IsVisible="{Binding $parent[shad:Sidebar].Expanded}" />

                <shad:SidebarItem Content="Dashboard" Command="{Binding GoToDashboardCommand}">
                    <shad:SidebarItem.Icon>
                        <LucideIcon Kind="LayoutDashboard" Size="20" StrokeWidth="1.5" />
                    </shad:SidebarItem.Icon>
                </shad:SidebarItem>

                <shad:SidebarItem Content="Employees" Command="{Binding GoToEmployeesCommand}">
                    <shad:SidebarItem.Icon>
                        <LucideIcon Kind="Users" Size="20" StrokeWidth="1.5" />
                    </shad:SidebarItem.Icon>
                </shad:SidebarItem>

            </StackPanel>

            <shad:Sidebar.Footer>
                <shad:SidebarItem Content="Settings" Command="{Binding GoToSettingsCommand}">
                    <shad:SidebarItem.Icon>
                        <LucideIcon Kind="Settings" Size="20" StrokeWidth="1.5" />
                    </shad:SidebarItem.Icon>
                </shad:SidebarItem>
            </shad:Sidebar.Footer>
        </shad:Sidebar>


        <DockPanel Grid.Column="1">

            <Border DockPanel.Dock="Top"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="0,0,0,1"
                Padding="20,16">
                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">

                    <ToggleButton Name="Toggler" Classes="Ghost" Padding="4" Width="32" Height="32">
                        <LucideIcon Kind="PanelLeft" Size="20" />
                    </ToggleButton>

                    <Separator Classes="Vertical" Height="20" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Application" Classes="Muted" VerticalAlignment="Center" />
                        <TextBlock Text="/" Classes="Muted" VerticalAlignment="Center" />
                        <TextBlock
                            Text="{Binding Navigator.CurrentView.Title, FallbackValue='Home'}"
                            Foreground="{DynamicResource Foreground}" VerticalAlignment="Center" />
                    </StackPanel>

                </StackPanel>
            </Border>

            <ContentControl Margin="30" Content="{Binding Navigator.CurrentView}" />

        </DockPanel>
    </Grid>

</shad:Window>