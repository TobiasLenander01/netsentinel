<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NetSentinel.ViewModels"
    xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
    x:Class="NetSentinel.Views.EmployeeDialogView"
    x:DataType="vm:EmployeeDialogViewModel">

    <Grid>
        <StackPanel Spacing="20" Margin="40" Width="400" HorizontalAlignment="Left">

            <TextBlock Text="{Binding Title}" Classes="h2" />

            <StackPanel Spacing="6">
                <TextBlock Text="Name" />
                <TextBox Text="{Binding Name}" Watermark="Full name" />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="Email" />
                <TextBox Text="{Binding Email}" Watermark="name@company.com" />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="Employee Number" />
                <TextBox Text="{Binding EmployeeNo}" Watermark="e.g. EMP001" />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="Department" />
                <ComboBox ItemsSource="{Binding Departments}"
                    SelectedItem="{Binding SelectedDepartment}"
                    HorizontalAlignment="Stretch"
                    PlaceholderText="Select a department">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <Button Content="Save" Classes="Primary" Command="{Binding SaveEmployeeCommand}" />

        </StackPanel>
    </Grid>
</UserControl>
