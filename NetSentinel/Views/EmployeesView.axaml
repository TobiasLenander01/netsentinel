<UserControl
xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:vm="using:NetSentinel.ViewModels"
xmlns:models="using:NetSentinel.Models"
xmlns:components="using:NetSentinel.Components"
x:Class="NetSentinel.Views.EmployeesView"
x:DataType="vm:EmployeesViewModel"
Loaded="OnLoaded">

    <Grid RowDefinitions="Auto,Auto,*" Margin="40">

        <!-- Row 0: Title -->
        <TextBlock Grid.Row="0" Text="{Binding Title}" Classes="h1" Margin="0,0,0,20" />

        <!-- Row 1: Add button -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Button Content="Add employee" Classes="Primary"
                    Command="{Binding ShowNewEmployeeDialogCommand}"
                    HorizontalAlignment="Left" IsEnabled="{Binding !IsLoading}" />
        </Grid>

        <!-- Row 2: Paginated data grid -->
        <components:PaginatedDataGrid Grid.Row="2" EmptyText="No employees found.">
            <components:PaginatedDataGrid.DataGridContent>
                <DataGrid
                ItemsSource="{Binding Employees}"
                CanUserSortColumns="True"
                IsReadOnly="True"
                IsEnabled="{Binding !IsLoading}"
                Background="{DynamicResource CardBackgroundColor}"
                GridLinesVisibility="Horizontal"
                VerticalAlignment="Top">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Employee No" Binding="{Binding EmployeeNumber}" Width="auto" />
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="auto" />
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="auto" />
                        <DataGridTextColumn Header="Department" Binding="{Binding Department.Name}" Width="*" />

                        <DataGridTemplateColumn Header="Actions">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:Employee">
                                    <Button Content="..." Classes="Ghost"
                                            HorizontalAlignment="Center"
                                            HorizontalContentAlignment="Center">
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuItem Header="Edit employee" Cursor="Hand"
                                                          Command="{Binding $parent[UserControl].((vm:EmployeesViewModel)DataContext).ShowEditEmployeeDialogCommand}"
                                                          CommandParameter="{Binding}" />
                                                <MenuItem Header="Delete employee" Cursor="Hand"
                                                          Command="{Binding $parent[UserControl].((vm:EmployeesViewModel)DataContext).ShowDeleteEmployeeDialogCommand}"
                                                          CommandParameter="{Binding}" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </components:PaginatedDataGrid.DataGridContent>
        </components:PaginatedDataGrid>

    </Grid>
</UserControl>
