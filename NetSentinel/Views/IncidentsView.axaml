<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NetSentinel.ViewModels"
    xmlns:models="using:NetSentinel.Models"
    xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
    x:Class="NetSentinel.Views.IncidentsView"
    x:DataType="vm:IncidentsViewModel"
    Loaded="OnLoaded">

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="40">

        <!-- Row 0: Title -->
        <TextBlock Grid.Row="0" Text="{Binding Title}" Classes="h1" Margin="0,0,0,20" />

        <!-- Row 1: Add button -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Button Content="Add incident" Classes="Primary"
                HorizontalAlignment="Left" IsEnabled="{Binding !IsLoading}" />
        </Grid>

        <!-- Row 2: DataGrid -->
        <Grid Grid.Row="2">
            <DataGrid x:Name="DataGrid"
                ItemsSource="{Binding Incidents}"
                CanUserSortColumns="True"
                IsReadOnly="True"
                IsEnabled="{Binding !IsLoading}"
                Background="{DynamicResource CardBackgroundColor}"
                GridLinesVisibility="Horizontal"
                VerticalAlignment="Top">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}"
                        Width="*" />
                    <DataGridTextColumn Header="CreatedAt" Binding="{Binding CreatedAt}"
                        Width="auto" />
                    <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="auto" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="auto" />
                    <DataGridTextColumn Header="Device" Binding="{Binding Device.Name}" Width="auto" />

                    <DataGridTemplateColumn Header="Actions">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:Incident">
                                <Button Content="..." Classes="Ghost"
                                    HorizontalAlignment="Center"
                                    HorizontalContentAlignment="Center">
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuItem Header="Edit incident" Cursor="Hand" />
                                            <MenuItem Header="Delete incident" Cursor="Hand"
                                                Command="{Binding $parent[UserControl].((vm:IncidentsViewModel)DataContext).ShowDeleteIncidentDialogCommand}"
                                                CommandParameter="{Binding}" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="No incidents found."
                IsVisible="{Binding IsEmpty}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="Gray"
                Margin="0,50,0,0" />

            <shad:BusyArea CornerRadius="{DynamicResource LgCornerRadius}"
                IsBusy="{Binding IsLoading}" />
        </Grid>

        <!-- Row 3: Pagination -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center"
            Spacing="12" Margin="0,12,0,0" IsVisible="{Binding !IsEmpty}">
            <Button Content="&lt;" Classes="Outline"
                Command="{Binding PreviousPageCommand}" />
            <TextBlock Text="{Binding PageInfo}"
                VerticalAlignment="Center" />
            <Button Content="&gt;" Classes="Outline"
                Command="{Binding NextPageCommand}" />
        </StackPanel>

    </Grid>
</UserControl>
