<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NetSentinel.ViewModels"
    xmlns:models="using:NetSentinel.Models"
    xmlns:components="using:NetSentinel.Components"
    x:Class="NetSentinel.Views.IncidentsView"
    x:DataType="vm:IncidentsViewModel"
    Loaded="OnLoaded">

    <Grid RowDefinitions="Auto,Auto,*" Margin="40">

        <!-- Row 0: Title -->
        <TextBlock Grid.Row="0" Text="{Binding Title}" Classes="h1" Margin="0,0,0,20" />

        <!-- Row 1: Add button -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Button Content="Add incident" Classes="Primary"
                Command="{Binding ShowNewIncidentDialogCommand}"
                HorizontalAlignment="Left" IsEnabled="{Binding !IsLoading}" />
        </Grid>

        <!-- Row 2: Paginated data grid -->
        <components:PaginatedDataGrid Grid.Row="2" EmptyText="No incidents found.">
            <components:PaginatedDataGrid.DataGridContent>
                <DataGrid x:Name="DataGrid"
                    ItemsSource="{Binding Incidents}"
                    CanUserSortColumns="True"
                    IsReadOnly="True"
                    IsEnabled="{Binding !IsLoading}"
                    Background="{DynamicResource CardBackgroundColor}"
                    GridLinesVisibility="Horizontal"
                    VerticalAlignment="Top">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Incident Number"
                            Binding="{Binding IncidentNumber}" Width="auto" />
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}"
                            Width="*" />
                        <DataGridTextColumn Header="Created At" Binding="{Binding CreatedAt}"
                            Width="auto" />
                        <DataGridTemplateColumn Header="Priority" Width="auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:Incident">
                                    <components:Priority Value="{Binding Priority}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Status" Width="auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:Incident">
                                    <components:Status Value="{Binding Status}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Device" Binding="{Binding Device.Name}"
                            Width="auto" />

                        <DataGridTemplateColumn Header="Actions">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:Incident">
                                    <Button Content="..." Classes="Ghost"
                                        HorizontalAlignment="Center"
                                        HorizontalContentAlignment="Center">
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuItem Header="Edit incident" Cursor="Hand"
                                                    Command="{Binding $parent[UserControl].((vm:IncidentsViewModel)DataContext).ShowEditIncidentDialogCommand}"
                                                    CommandParameter="{Binding}" />
                                                <MenuItem Header="Delete incident" Cursor="Hand"
                                                    Command="{Binding $parent[UserControl].((vm:IncidentsViewModel)DataContext).ShowDeleteIncidentDialogCommand}"
                                                    CommandParameter="{Binding}" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </components:PaginatedDataGrid.DataGridContent>
        </components:PaginatedDataGrid>

    </Grid>
</UserControl>