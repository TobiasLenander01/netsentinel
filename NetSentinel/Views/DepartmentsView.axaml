<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NetSentinel.ViewModels"
    xmlns:models="using:NetSentinel.Models"
    xmlns:components="using:NetSentinel.Components"
    x:Class="NetSentinel.Views.DepartmentsView"
    x:DataType="vm:DepartmentsViewModel"
    Loaded="OnLoaded">

    <Grid RowDefinitions="Auto,Auto,*" Margin="40">

        <!-- Row 0: Title -->
        <TextBlock Grid.Row="0" Text="{Binding Title}" Classes="h1" Margin="0,0,0,20" />

        <!-- Row 1: Add button -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Button Content="Add department" Classes="Primary"
                Command="{Binding ShowNewDepartmentDialogCommand}"
                HorizontalAlignment="Left" IsEnabled="{Binding !IsLoading}" />
        </Grid>

        <!-- Row 2: Paginated data grid -->
        <components:PaginatedDataGrid Grid.Row="2" EmptyText="No departments found.">
            <components:PaginatedDataGrid.DataGridContent>
                <DataGrid x:Name="DataGrid"
                    ItemsSource="{Binding Departments}"
                    CanUserSortColumns="True"
                    IsReadOnly="True"
                    IsEnabled="{Binding !IsLoading}"
                    Background="{DynamicResource CardBackgroundColor}"
                    GridLinesVisibility="Horizontal"
                    VerticalAlignment="Top">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="auto" />
                        <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="auto" />
                        <DataGridTextColumn Header="Employees" Binding="{Binding Employees.Count}" Width="*" />

                        <DataGridTemplateColumn Header="Actions">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:Department">
                                    <Button Content="..." Classes="Ghost"
                                        HorizontalAlignment="Center"
                                        HorizontalContentAlignment="Center">
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuItem Header="Edit department" Cursor="Hand"
                                                    Command="{Binding $parent[UserControl].((vm:DepartmentsViewModel)DataContext).ShowEditDepartmentDialogCommand}"
                                                    CommandParameter="{Binding}" />
                                                <MenuItem Header="Delete department" Cursor="Hand"
                                                    Command="{Binding $parent[UserControl].((vm:DepartmentsViewModel)DataContext).ShowDeleteDepartmentDialogCommand}"
                                                    CommandParameter="{Binding}" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </components:PaginatedDataGrid.DataGridContent>
        </components:PaginatedDataGrid>

    </Grid>
</UserControl>