<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NetSentinel.ViewModels"
    xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
    x:Class="NetSentinel.Views.SettingsView"
    x:DataType="vm:SettingsViewModel">

    <StackPanel Spacing="24" Margin="40">

        <TextBlock Text="{Binding Title}" Classes="h1" />

        <shad:Card Padding="24">
            <StackPanel Spacing="16">

                <StackPanel Spacing="4">
                    <TextBlock Text="Database" Classes="h3" />
                    <TextBlock
                        Text="Manage test data. Seeding will clear existing rows and insert a fresh set of sample records."
                        Classes="Muted"
                        TextWrapping="Wrap" />
                </StackPanel>

                <Border
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="0,1,0,0" />

                <StackPanel Orientation="Horizontal" Spacing="12">

                    <Button Command="{Binding SeedDatabaseCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <LucideIcon Kind="DatabaseZap" Size="16" StrokeWidth="1.5" />
                            <TextBlock Text="Seed Database" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ClearDatabaseCommand}" Classes="Destructive">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <LucideIcon Kind="Trash2" Size="16" StrokeWidth="1.5" />
                            <TextBlock Text="Clear Database" />
                        </StackPanel>
                    </Button>

                </StackPanel>

            </StackPanel>
        </shad:Card>

    </StackPanel>
</UserControl>