<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NetSentinel.ViewModels"
    xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
    x:Class="NetSentinel.Views.DashboardView"
    x:DataType="vm:DashboardViewModel">

    <StackPanel Spacing="20" Margin="40">

        <TextBlock Text="{Binding Title}" Classes="h1" />

        <Button Command="{Binding TestAddDeviceCommand}" Content="Add Device"/>

        <shad:Card Padding="20">
            <TextBlock Text="I am a Card!" />
        </shad:Card>

    </StackPanel>
</UserControl>