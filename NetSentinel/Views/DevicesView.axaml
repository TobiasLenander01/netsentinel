<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NetSentinel.ViewModels"
    xmlns:models="using:NetSentinel.Models"
    xmlns:components="using:NetSentinel.Components"
    x:Class="NetSentinel.Views.DevicesView"
    x:DataType="vm:DevicesViewModel"
    Loaded="OnLoaded">

    <Grid RowDefinitions="Auto,Auto,*" Margin="40">

        <!-- Row 0: Title -->
        <TextBlock Grid.Row="0" Text="{Binding Title}" Classes="h1" Margin="0,0,0,20" />

        <!-- Row 1: Add button -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Button Content="Add device" Classes="Primary"
                Command="{Binding ShowNewDeviceDialogCommand}"
                HorizontalAlignment="Left" IsEnabled="{Binding !IsLoading}" />
        </Grid>

        <!-- Row 2: Paginated data grid -->
        <components:PaginatedDataGrid Grid.Row="2" EmptyText="No devices found.">
            <components:PaginatedDataGrid.DataGridContent>
                <DataGrid x:Name="DataGrid"
                    ItemsSource="{Binding Devices}"
                    CanUserSortColumns="True"
                    IsReadOnly="True"
                    IsEnabled="{Binding !IsLoading}"
                    Background="{DynamicResource CardBackgroundColor}"
                    GridLinesVisibility="Horizontal"
                    VerticalAlignment="Top">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="auto" />
                        <DataGridTextColumn Header="Owner" Binding="{Binding Owner.Name}" Width="auto" />
                        <DataGridTextColumn Header="IP Address" Binding="{Binding IPAddress}" Width="auto" />
                        <DataGridTextColumn Header="Serial Number" Binding="{Binding SerialNumber}" Width="*" />

                        <DataGridTemplateColumn Header="Status" Width="auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:Device">
                                    <LucideIcon Kind="TriangleAlert" Size="18"
                                        Foreground="Orange"
                                        IsVisible="{Binding HasIncidents}"
                                        HorizontalAlignment="Center"
                                        Cursor="Hand"
                                        ToolTip.Tip="{Binding Incidents.Count, StringFormat='This device has {0} incident(s)'}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Actions">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:Device">
                                    <Button Content="..." Classes="Ghost"
                                        HorizontalAlignment="Center"
                                        HorizontalContentAlignment="Center">
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuItem Header="Edit device" Cursor="Hand"
                                                    Command="{Binding $parent[UserControl].((vm:DevicesViewModel)DataContext).ShowEditDeviceDialogCommand}"
                                                    CommandParameter="{Binding}" />
                                                <MenuItem Header="Delete device" Cursor="Hand"
                                                    Command="{Binding $parent[UserControl].((vm:DevicesViewModel)DataContext).ShowDeleteDeviceDialogCommand}"
                                                    CommandParameter="{Binding}" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </components:PaginatedDataGrid.DataGridContent>
        </components:PaginatedDataGrid>

    </Grid>
</UserControl>
