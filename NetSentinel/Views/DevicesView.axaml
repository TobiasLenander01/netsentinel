<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NetSentinel.ViewModels"
    xmlns:models="using:NetSentinel.Models"
    xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
    x:Class="NetSentinel.Views.DevicesView"
    x:DataType="vm:DevicesViewModel"
    Loaded="OnLoaded">

    <Grid>

        <StackPanel Spacing="20" Margin="40">

            <TextBlock Text="{Binding Title}" Classes="h1" />

            <Grid>
                <Button Content="Add device" Classes="Primary"
                    Command="{Binding ShowNewDeviceDialogCommand}"
                    HorizontalAlignment="Left" />
            </Grid>

            <Grid>

                <DataGrid x:Name="DataGrid"
                    ItemsSource="{Binding Devices}"
                    CanUserSortColumns="True"
                    IsReadOnly="True"
                    Background="{DynamicResource CardBackgroundColor}"
                    GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="auto" />
                        <DataGridTextColumn Header="Owner" Binding="{Binding Owner.Name}"
                            Width="auto" />
                        <DataGridTextColumn Header="IP Address" Binding="{Binding IPAddress}"
                            Width="auto" />
                        <DataGridTextColumn Header="Serial Number" Binding="{Binding SerialNumber}"
                            Width="*" />

                        <DataGridTemplateColumn Header="Status" Width="auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:Device">
                                    <LucideIcon Kind="TriangleAlert" Size="18"
                                        Foreground="Orange"
                                        IsVisible="{Binding HasIncidents}"
                                        HorizontalAlignment="Center"
                                        Cursor="Hand"
                                        ToolTip.Tip="{Binding Incidents.Count, StringFormat='This device has {0} incident(s)'}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Actions">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:Device">
                                    <Button Content="..." Classes="Ghost Icon"
                                        HorizontalAlignment="Center"
                                        HorizontalContentAlignment="Center">
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuItem Header="Edit device" Cursor="Hand"
                                                    Command="{Binding $parent[UserControl].((vm:DevicesViewModel)DataContext).ShowEditDeviceDialogCommand}"
                                                    CommandParameter="{Binding}" />
                                                <MenuItem Header="Delete device" Cursor="Hand"
                                                    Command="{Binding $parent[UserControl].((vm:DevicesViewModel)DataContext).ShowDeleteDeviceDialogCommand}"
                                                    CommandParameter="{Binding}" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="No devices found."
                    IsVisible="{Binding IsEmpty}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="Gray"
                    Margin="0,50,0,0" />

                <shad:BusyArea CornerRadius="{DynamicResource LgCornerRadius}"
                    IsBusy="{Binding IsLoading}" />

            </Grid>

        </StackPanel>
    </Grid>
</UserControl>