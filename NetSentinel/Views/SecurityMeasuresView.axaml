<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NetSentinel.ViewModels"
    xmlns:models="using:NetSentinel.Models"
    xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
    x:Class="NetSentinel.Views.SecurityMeasuresView"
    x:DataType="vm:SecurityMeasuresViewModel"
    Loaded="OnLoaded">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="40">

        <!-- Row 0: Title -->
        <TextBlock Grid.Row="0" Text="{Binding Title}" Classes="h1" Margin="0,0,0,20" />

        <!-- Row 1: Add button -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Button Content="Add security measure" Classes="Primary"
                Command="{Binding ShowNewSecurityMeasureDialogCommand}"
                HorizontalAlignment="Left" IsEnabled="{Binding !IsLoading}" />
        </Grid>

        <!-- Row 2: DataGrid -->
        <Grid Grid.Row="2">
            <DataGrid x:Name="DataGrid"
                ItemsSource="{Binding SecurityMeasures}"
                CanUserSortColumns="True"
                IsReadOnly="True"
                IsEnabled="{Binding !IsLoading}"
                Background="{DynamicResource CardBackgroundColor}"
                GridLinesVisibility="Horizontal"
                VerticalAlignment="Top">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Description" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:SecurityMeasure">
                                <TextBlock Text="{Binding Description}"
                                    TextWrapping="Wrap"
                                    MaxLines="3"
                                    TextTrimming="CharacterEllipsis"
                                    VerticalAlignment="Center"
                                    Margin="12,8" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="*" />
                    <DataGridTextColumn Header="Performed By" Binding="{Binding PerformedBy.Name}" Width="*" />
                    <DataGridTextColumn Header="Performed At" Binding="{Binding PerformedAt}" Width="auto" />
                    <DataGridTextColumn Header="Incident" Binding="{Binding Incident.Description}" Width="*" />

                    <DataGridTemplateColumn Header="Actions" Width="auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:SecurityMeasure">
                                <Button Content="..." Classes="Ghost"
                                    HorizontalAlignment="Center"
                                    HorizontalContentAlignment="Center">
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuItem Header="Edit security measure" Cursor="Hand"
                                                Command="{Binding $parent[UserControl].((vm:SecurityMeasuresViewModel)DataContext).ShowEditSecurityMeasureDialogCommand}"
                                                CommandParameter="{Binding}" />
                                            <MenuItem Header="Delete security measure" Cursor="Hand"
                                                Command="{Binding $parent[UserControl].((vm:SecurityMeasuresViewModel)DataContext).ShowDeleteSecurityMeasureDialogCommand}"
                                                CommandParameter="{Binding}" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="No security measures found."
                IsVisible="{Binding IsEmpty}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="Gray"
                Margin="0,50,0,0" />

            <shad:BusyArea CornerRadius="{DynamicResource LgCornerRadius}"
                IsBusy="{Binding IsLoading}" />
        </Grid>

        <!-- Row 3: Pagination -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center"
            Spacing="12" Margin="0,12,0,0" IsVisible="{Binding !IsEmpty}">
            <Button Classes="Outline" Command="{Binding FirstPageCommand}" ToolTip.Tip="First page">
                <LucideIcon Kind="ArrowLeftToLine" Size="16" />
            </Button>
            <Button Classes="Outline" Command="{Binding PreviousPageCommand}" ToolTip.Tip="Previous page">
                <LucideIcon Kind="ArrowLeft" Size="16" />
            </Button>
            <TextBlock Text="{Binding PageInfo}"
                VerticalAlignment="Center" />
            <Button Classes="Outline" Command="{Binding NextPageCommand}" ToolTip.Tip="Next page">
                <LucideIcon Kind="ArrowRight" Size="16" />
            </Button>
            <Button Classes="Outline" Command="{Binding LastPageCommand}" ToolTip.Tip="Last page">
                <LucideIcon Kind="ArrowRightToLine" Size="16" />
            </Button>
        </StackPanel>

    </Grid>
</UserControl>
