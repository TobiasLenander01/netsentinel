<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NetSentinel.ViewModels"
    xmlns:models="using:NetSentinel.Models"
    xmlns:components="using:NetSentinel.Components"
    x:Class="NetSentinel.Views.SecurityMeasuresView"
    x:DataType="vm:SecurityMeasuresViewModel"
    Loaded="OnLoaded">

    <Grid RowDefinitions="Auto,Auto,*" Margin="40">

        <!-- Row 0: Title -->
        <TextBlock Grid.Row="0" Text="{Binding Title}" Classes="h1" Margin="0,0,0,20" />

        <!-- Row 1: Add button -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Button Content="Add security measure" Classes="Primary"
                Command="{Binding ShowNewSecurityMeasureDialogCommand}"
                HorizontalAlignment="Left" IsEnabled="{Binding !IsLoading}" />
        </Grid>

        <!-- Row 2: Paginated data grid -->
        <components:PaginatedDataGrid Grid.Row="2" EmptyText="No security measures found.">
            <components:PaginatedDataGrid.DataGridContent>
                <DataGrid x:Name="DataGrid"
                    ItemsSource="{Binding SecurityMeasures}"
                    CanUserSortColumns="True"
                    IsReadOnly="True"
                    IsEnabled="{Binding !IsLoading}"
                    Background="{DynamicResource CardBackgroundColor}"
                    GridLinesVisibility="Horizontal"
                    VerticalAlignment="Top">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Security Measure Number"
                            Binding="{Binding SecurityMeasureNumber}" Width="auto" />
                        <DataGridTemplateColumn Header="Description" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:SecurityMeasure">
                                    <TextBlock Text="{Binding Description}"
                                        TextWrapping="Wrap"
                                        MaxLines="3"
                                        TextTrimming="CharacterEllipsis"
                                        VerticalAlignment="Center"
                                        Margin="12,8" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="*" />
                        <DataGridTextColumn Header="Performed By"
                            Binding="{Binding PerformedBy.Name}" Width="*" />
                        <DataGridTextColumn Header="Performed At" Binding="{Binding PerformedAt}"
                            Width="*" />
                        <DataGridTextColumn Header="Incident"
                            Binding="{Binding Incident.Description}" Width="*" />

                        <DataGridTemplateColumn Header="Actions" Width="auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:SecurityMeasure">
                                    <Button Content="..." Classes="Ghost"
                                        HorizontalAlignment="Center"
                                        HorizontalContentAlignment="Center">
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuItem Header="Edit security measure"
                                                    Cursor="Hand"
                                                    Command="{Binding $parent[UserControl].((vm:SecurityMeasuresViewModel)DataContext).ShowEditSecurityMeasureDialogCommand}"
                                                    CommandParameter="{Binding}" />
                                                <MenuItem Header="Delete security measure"
                                                    Cursor="Hand"
                                                    Command="{Binding $parent[UserControl].((vm:SecurityMeasuresViewModel)DataContext).ShowDeleteSecurityMeasureDialogCommand}"
                                                    CommandParameter="{Binding}" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </components:PaginatedDataGrid.DataGridContent>
        </components:PaginatedDataGrid>

    </Grid>
</UserControl>